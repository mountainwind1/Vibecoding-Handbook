#!/bin/bash
# 设置 / 修改项目地图的访问口令（Caddy 跑在名为 caddy 的容器里；宿主机直装就把 docker exec caddy 去掉）。口令只在这个终端里输入、不回显，文件里只存 bcrypt 哈希。
set -euo pipefail
read -rp "用户名: " U
[[ "$U" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || { echo "用户名只能用字母、数字和 . _ -，没写入"; exit 1; }
read -rsp "口令（不回显）: " P; echo
read -rsp "再输一遍: " P2; echo
[ "$P" = "$P2" ] || { echo "两次不一致，没写入"; exit 1; }
[ "${#P}" -ge 10 ] || { echo "口令至少 10 位，没写入"; exit 1; }
H=$(docker exec caddy caddy hash-password --plaintext "$P")
unset P P2
[[ "$H" =~ ^\$2[aby]\$[0-9]{2}\$.{53}$ ]] || { echo "生成哈希失败，没写入"; exit 1; }
umask 022
printf '%s %s\n' "$U" "$H" > /srv/vibe-map-auth/users.tmp
mv /srv/vibe-map-auth/users.tmp /srv/vibe-map-auth/users
echo "已写入（用户 $U）"
if docker inspect caddy --format '{{range .Mounts}}{{.Destination}} {{end}}' | grep -q /etc/caddy/vibe-map-auth; then
  docker exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 && echo "Caddy 已重新加载，新口令生效"
fi
