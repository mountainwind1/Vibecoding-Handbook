#!/bin/sh
# vibe-map 发布接收端（vibe-deploy 的 SSH 强制命令）：只认「项目名」一个参数，
# 装法：放到 /usr/local/bin/，vibe-deploy 的 authorized_keys 写 command="/usr/local/bin/vibe-map-receive",restrict <公钥>
# 从标准输入收 tar 包，解到临时目录、丢掉符号链接、原子替换 /srv/vibe-map/<项目名>/
set -eu
p="${SSH_ORIGINAL_COMMAND:-}"
case "$p" in
  ''|.*|*/*|*[!A-Za-z0-9._-]*) echo "vibe-map: 项目名不合法：$p" >&2; exit 2 ;;
esac
[ "${#p}" -le 64 ] || { echo "vibe-map: 项目名太长" >&2; exit 2; }
root="${VIBE_MAP_ROOT:-/srv/vibe-map}"      # 自检时换成临时目录
tmp=$(mktemp -d "$root/.incoming.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
tar -C "$tmp" --no-same-owner --no-same-permissions -xf -
find "$tmp" -type l -delete
chmod -R u=rwX,go=rX "$tmp"
[ -f "$tmp/index.html" ] || { echo "vibe-map: 包里没有 index.html" >&2; exit 3; }
old="$root/.old.$p.$$"
if [ -e "$root/$p" ]; then mv "$root/$p" "$old"; fi
mv "$tmp" "$root/$p"
trap - EXIT
rm -rf "$old"
# 总入口：包里带的 portal.html 装成站点根的 index.html；projects.json 列出有摘要的项目（名字都过了上面的守卫，可直接拼 JSON）
if [ -f "$root/$p/portal.html" ]; then cp "$root/$p/portal.html" "$root/.index.tmp" && chmod 644 "$root/.index.tmp" && mv "$root/.index.tmp" "$root/index.html"; fi
{ printf '['; sep=''; for d in "$root"/*/; do n=$(basename "$d"); [ -f "$d/summary.json" ] || continue; printf '%s"%s"' "$sep" "$n"; sep=','; done; printf ']\n'; } > "$root/.projects.tmp"
chmod 644 "$root/.projects.tmp" && mv "$root/.projects.tmp" "$root/projects.json"
echo "vibe-map: 已更新 $p"
